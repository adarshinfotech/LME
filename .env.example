# ---------------------------------------------------------------
# LMI — environment variables
# Copy to .env.local for development. Never commit real values.
# ---------------------------------------------------------------

# Public site URL (canonical links, sitemap, social previews)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=        # or NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SECRET_KEY=                         # or SUPABASE_SERVICE_ROLE_KEY — server only, never NEXT_PUBLIC_

# Random string used to hash applicant IPs for rate limiting (e.g. `openssl rand -hex 32`)
IP_HASH_SALT=

# Optional public contact details (hidden when empty — nothing is invented)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Optional official list price to show crossed out next to the launch offer.
# Leave empty unless this is an approved, real list price.
NEXT_PUBLIC_PARTNER_LIST_PRICE=

# Optional Cloudflare Turnstile anti-spam challenge on the application form
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Local preview mode only (used when Supabase vars are empty during `npm run dev`)
LOCAL_ADMIN_PASSWORD=
